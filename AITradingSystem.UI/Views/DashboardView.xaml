<UserControl x:Class="AITradingSystem.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E" Foreground="White">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
        <TextBlock Text="Обзор системы" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#2D2D30" Padding="20" CornerRadius="5" Margin="5">
                <StackPanel>
                    <TextBlock Text="Внутренний баланс бота (USDT)" Foreground="#AAAAAA" FontSize="14" />
                    <TextBlock Text="{Binding CurrentBalance, StringFormat={}{0:F2}}" FontSize="32" FontWeight="Bold" Foreground="#4CAF50" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="#2D2D30" Padding="20" CornerRadius="5" Margin="5">
                <StackPanel>
                    <TextBlock Text="Дневной PnL" Foreground="#AAAAAA" FontSize="14" />
                    <TextBlock Text="{Binding DailyPnL, StringFormat={}{0:F2} USDT}" FontSize="32" FontWeight="Bold" />
                    <TextBlock Text="{Binding DailyPnLPercentText}" FontSize="16" Foreground="#AAAAAA" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="#2D2D30" Padding="20" CornerRadius="5" Margin="5">
                <StackPanel>
                    <TextBlock Text="Просадка" Foreground="#AAAAAA" FontSize="14" />
                    <TextBlock Text="{Binding DrawdownText}" FontSize="32" FontWeight="Bold" Foreground="#F44336" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#2D2D30" Padding="20" CornerRadius="5" Margin="5">
                <StackPanel>
                    <TextBlock Text="Всего сделок" Foreground="#AAAAAA" FontSize="14" />
                    <TextBlock Text="{Binding TotalTrades}" FontSize="28" FontWeight="Bold" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="#2D2D30" Padding="20" CornerRadius="5" Margin="5">
                <StackPanel>
                    <TextBlock Text="Среднее время AI-инференса (мс)" Foreground="#AAAAAA" FontSize="14" />
                    <TextBlock Text="{Binding AvgInferenceTime, StringFormat={}{0:F0}}" FontSize="28" FontWeight="Bold" />
                </StackPanel>
            </Border>
        </Grid>
        <Border Background="#2D2D30" Padding="15" CornerRadius="5" Margin="5,15,5,5">
            <StackPanel>
                <TextBlock Text="{Binding EnvironmentText, StringFormat='Биржа: {0}'}" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="{Binding ModeText}" Foreground="#FFC107" TextWrapping="Wrap" Margin="0,5"/>
                <TextBlock Text="{Binding KeysStatusText}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding ConnectionText}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding AccountUpdatedText}" Foreground="#AAAAAA" Margin="0,3,0,10"/>
                <UniformGrid Columns="3">
                    <StackPanel Margin="5"><TextBlock Text="USDT free / locked"/><TextBlock Text="{Binding UsdtFree}" FontSize="20"/><TextBlock Text="{Binding UsdtLocked, StringFormat=Locked: {0}}" Foreground="#AAAAAA"/></StackPanel>
                    <StackPanel Margin="5"><TextBlock Text="FDUSD free / locked"/><TextBlock Text="{Binding FdusdFree}" FontSize="20"/><TextBlock Text="{Binding FdusdLocked, StringFormat=Locked: {0}}" Foreground="#AAAAAA"/></StackPanel>
                    <StackPanel Margin="5"><TextBlock Text="USDC free / locked"/><TextBlock Text="{Binding UsdcFree}" FontSize="20"/><TextBlock Text="{Binding UsdcLocked, StringFormat=Locked: {0}}" Foreground="#AAAAAA"/></StackPanel>
                </UniformGrid>
                <TextBlock Text="{Binding EquityText, StringFormat=Оценка активов: {0}}" FontSize="17" Margin="5,10"/>
                <TextBlock Text="Оценка в USDT может быть частичной. Это не PnL бота." Foreground="#AAAAAA" TextWrapping="Wrap"/>
                <DataGrid ItemsSource="{Binding AssetBalances}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="230" Margin="0,10,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Актив" Binding="{Binding Asset}" Width="120"/>
                        <DataGridTextColumn Header="Свободно" Binding="{Binding Free, StringFormat={}{0:0.########}}" Width="180"/>
                        <DataGridTextColumn Header="Заблокировано" Binding="{Binding Locked, StringFormat={}{0:0.########}}" Width="180"/>
                        <DataGridTextColumn Header="Всего" Binding="{Binding Total, StringFormat={}{0:0.########}}" Width="180"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
        <Border Background="#2D2D30" Padding="15" CornerRadius="5" Margin="5">
            <StackPanel>
                <TextBlock Text="AI / GPU — фактическое состояние загрузки" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="{Binding BackendText}" TextWrapping="Wrap" Margin="0,8"/>
                <TextBlock Text="{Binding LastInferenceText, StringFormat=Последний инференс: {0}}"/>
                <TextBlock Text="{Binding LastErrorText}" Foreground="#FFC107" TextWrapping="Wrap" Margin="0,8"/>
            </StackPanel>
        </Border>
        <Border Background="#2D2D30" Padding="15" CornerRadius="5" Margin="5">
            <StackPanel>
                <TextBlock Text="Реконсиляция / user-data stream / kill-switch (P0.5–P0.6)" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="{Binding ReconciliationText}" TextWrapping="Wrap" Margin="0,8"/>
                <TextBlock Text="{Binding ReconciliationAlertText}" Foreground="#FFC107" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <Border Background="#2D2D30" Padding="15" CornerRadius="5" Margin="5">
            <StackPanel>
                <TextBlock Text="Дрейф часов относительно Binance (P1.8)" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="{Binding ClockDriftText}" TextWrapping="Wrap" Margin="0,8"/>
                <TextBlock Text="{Binding ClockDriftAlertText}" Foreground="#FFC107" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <Border Background="#2D2D30" Padding="15" CornerRadius="5" Margin="5">
            <StackPanel>
                <TextBlock Text="Очередь исполнения (P0.3) — защита и закрытие обгоняют входы" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="{Binding ExecutionQueueText}" TextWrapping="Wrap" Margin="0,8"/>
                <TextBlock Text="{Binding ExecutionQueueAlertText}" Foreground="#FFC107" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <Border Background="#2D2D30" Padding="15" CornerRadius="5" Margin="5">
            <StackPanel>
                <TextBlock Text="Портфельный риск (P1.7) — экспозиция / корреляция / серия убытков" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="{Binding PortfolioRiskText}" TextWrapping="Wrap" Margin="0,8"/>
                <TextBlock Text="{Binding PortfolioRiskAlertText}" Foreground="#FFC107" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <Border Background="#2D2D30" Padding="15" CornerRadius="5" Margin="5">
            <StackPanel>
                <TextBlock Text="Бюджет весов REST / rate-limit (P1.6) + ликвидность (P1.5)" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="{Binding RateLimitText}" TextWrapping="Wrap" Margin="0,8"/>
                <TextBlock Text="{Binding RateLimitAlertText}" Foreground="#FFC107" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </StackPanel></ScrollViewer>
</UserControl>