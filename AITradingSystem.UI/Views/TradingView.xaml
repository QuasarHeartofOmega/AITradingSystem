<UserControl x:Class="AITradingSystem.UI.Views.TradingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E" Foreground="White">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
        <Border Background="#2D2D30" Padding="15" CornerRadius="5" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Последний AI-сигнал" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock Text="{Binding LastSignalText}" TextWrapping="Wrap" FontFamily="Consolas" Foreground="#4CAF50"/>
            </StackPanel>
        </Border>
        <DockPanel Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Сброс kill-switch" Padding="10,6" Margin="8,0,0,0"
                    Command="{Binding ResetKillSwitchCommand}"
                    ToolTip="Снять блокировку новых входов после разбора причины (P0.6)"/>
            <Button DockPanel.Dock="Right" Content="🛑 ПАНИКА: закрыть всё" Padding="12,6" FontWeight="Bold"
                    Background="#C62828" Foreground="White" BorderThickness="0"
                    Command="{Binding PanicCloseAllCommand}"
                    ToolTip="Kill-switch: закрыть все позиции по рынку и заблокировать новые входы (P0.6)"/>
            <TextBlock Text="Позиции бота (не все остатки биржи)" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock Text="{Binding PanicStatusText}" Foreground="#FF5252" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <DataGrid ItemsSource="{Binding OpenPositions}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="230" Margin="0,0,0,15">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Символ" Binding="{Binding Symbol}" Width="100"/>
                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="80"/>
                <DataGridTextColumn Header="Entry basis" Binding="{Binding EntryBasis}" Width="140"/>
                <DataGridTextColumn Header="Сторона" Binding="{Binding Side}" Width="70"/>
                <DataGridTextColumn Header="Количество" Binding="{Binding Quantity, StringFormat={}{0:0.########}}" Width="130"/>
                <DataGridTextColumn Header="External доля" Binding="{Binding ExternalQuantity, StringFormat={}{0:0.########}}" Width="120"/>
                <DataGridTextColumn Header="Вход" Binding="{Binding EntryPrice, StringFormat={}{0:0.##########}}" Width="130"/>
                <DataGridTextColumn Header="Текущая" Binding="{Binding CurrentPrice, StringFormat={}{0:0.##########}}" Width="130"/>
                <DataGridTextColumn Header="PnL" Binding="{Binding UnrealizedPnL, StringFormat={}{0:0.##}}" Width="90"/>
                <DataGridTextColumn Header="Обновлено UTC" Binding="{Binding UpdatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="150"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding DustReviewReason}" Width="220"/>
                <DataGridTemplateColumn Header="Действие" Width="190"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Закрыть" Margin="0,0,6,0" Command="{Binding DataContext.ClosePositionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                        <Button Content="Release" ToolTip="Phase 1.7: забрать остаток себе — снять защиту бота без продажи"
                                Command="{Binding DataContext.ReleaseExternalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Symbol}"/>
                    </StackPanel>
                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="External / ручные позиции (Phase 1.7)" FontSize="18" FontWeight="Bold" Margin="0,0,0,6"/>
        <TextBlock Text="{Binding ExternalStatusText}" Foreground="#FFC107" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <DataGrid ItemsSource="{Binding ExternalCandidates}" AutoGenerateColumns="False" IsReadOnly="False" MaxHeight="220" Margin="0,0,0,15">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Символ" Binding="{Binding Symbol}" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="External объём" Binding="{Binding ExternalQuantity, StringFormat={}{0:0.########}}" Width="130" IsReadOnly="True"/>
                <DataGridTextColumn Header="Объём бота" Binding="{Binding BotQuantity, StringFormat={}{0:0.########}}" Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="Оценка USDT" Binding="{Binding NotionalQuote, StringFormat={}{0:0.##}}" Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="Предлож. вход" Binding="{Binding ProposedEntryPrice, StringFormat={}{0:0.##########}}" Width="130" IsReadOnly="True"/>
                <DataGridTextColumn Header="Предлож. SL" Binding="{Binding ProposedStopLoss, StringFormat={}{0:0.##########}}" Width="130" IsReadOnly="True"/>
                <DataGridTextColumn Header="Предлож. TP" Binding="{Binding ProposedTakeProfit, StringFormat={}{0:0.##########}}" Width="130" IsReadOnly="True"/>
                <DataGridTextColumn Header="Основа входа" Binding="{Binding EntryBasis}" Width="150" IsReadOnly="True"/>
                <DataGridTextColumn Header="Ручной вход" Binding="{Binding ManualEntryPrice, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="170" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Действие" Width="140"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Подхватить" Margin="0,0,6,0" ToolTip="Согласие оператора: сопровождать и защищать объём; kill-switch закроет и его"
                                Command="{Binding DataContext.AdoptExternalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                        <Button Content="Release" ToolTip="Оставить себе: бот не сопровождает и не продаёт"
                                Command="{Binding DataContext.ReleaseExternalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Symbol}"/>
                    </StackPanel>
                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Обновить аккаунт" Padding="10,5" Command="{Binding RefreshAccountCommand}"/>
            <TextBlock Text="Биржевые спотовые остатки и открытые ордера" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
        </DockPanel>
        <TextBlock Text="{Binding AccountStatusText}" Foreground="#FFC107" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <TextBlock Text="Позиции на бирже · оценка в USDT" FontWeight="Bold" Margin="0,0,0,5"/>
        <DataGrid ItemsSource="{Binding ExchangePositions}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="230" Margin="0,0,0,15">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Актив" Binding="{Binding Asset}" Width="90"/>
                <DataGridTextColumn Header="Свободно" Binding="{Binding Free, StringFormat={}{0:0.########}}" Width="130"/>
                <DataGridTextColumn Header="Заблокировано" Binding="{Binding Locked, StringFormat={}{0:0.########}}" Width="130"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding LastPrice, StringFormat={}{0:0.##########}}" Width="130"/>
                <DataGridTextColumn Header="Оценка USDT" Binding="{Binding ValueInQuote, StringFormat={}{0:0.##}}" Width="120"/>
                <DataGridTextColumn Header="Маршрут цены" Binding="{Binding PriceRoute}" Width="200"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="Открытые ордера на бирже" FontWeight="Bold" Margin="0,0,0,5"/>
        <DataGrid ItemsSource="{Binding ExchangeOpenOrders}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="230" Margin="0,0,0,15">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Символ" Binding="{Binding Symbol}" Width="110"/>
                <DataGridTextColumn Header="Сторона" Binding="{Binding Side}" Width="70"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="110"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="110"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat={}{0:0.##########}}" Width="130"/>
                <DataGridTextColumn Header="Количество" Binding="{Binding OriginalQuantity, StringFormat={}{0:0.########}}" Width="130"/>
                <DataGridTextColumn Header="Исполнено %" Binding="{Binding FillPercent, StringFormat={}{0:0.##}}" Width="100"/>
                <DataGridTextColumn Header="Время UTC" Binding="{Binding CreatedAt, StringFormat={}{0:HH:mm:ss}}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="История сделок бота" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
        <DataGrid ItemsSource="{Binding TradeHistoryItems}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="260" Margin="0,0,0,15">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Символ" Binding="{Binding Symbol}" Width="100"/>
                <DataGridTextColumn Header="Сторона" Binding="{Binding Side}" Width="70"/>
                <DataGridTextColumn Header="Вход" Binding="{Binding EntryPrice, StringFormat={}{0:0.##########}}" Width="130"/>
                <DataGridTextColumn Header="Выход" Binding="{Binding ExitPrice, StringFormat={}{0:0.##########}}" Width="130"/>
                <DataGridTextColumn Header="PnL" Binding="{Binding PnL, StringFormat={}{0:0.##}}" Width="90"/>
                <DataGridTextColumn Header="Причина" Binding="{Binding ExitReason}" Width="140"/>
                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity, StringFormat={}{0:0.########}}" Width="120"/>
                <DataGridTextColumn Header="Закрыта UTC" Binding="{Binding ClosedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="160"/>
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel></ScrollViewer>
</UserControl>