<Window x:Class="AITradingSystem.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AITradingSystem.UI.Views"
        Title="AI Trading System" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E" Foreground="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{Binding AccountBannerBackground}" Padding="10,6">
            <TextBlock Text="{Binding AccountBanner}" Foreground="{Binding AccountBannerForeground}" FontWeight="Bold" TextWrapping="Wrap"/>
        </Border>
        <!-- Верхняя панель -->
        <Border Grid.Row="1" Background="#2D2D30" Padding="10" BorderBrush="#3E3E42" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Статус:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="0,0,20,0" Foreground="#4CAF50" FontWeight="Bold" />

                <Button Content="▶ Старт" Width="80" Margin="5" Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}" Background="#2E7D32" Foreground="White" FontWeight="Bold" BorderThickness="0" />
                <Button Content="⏸ Пауза" Width="80" Margin="5" Command="{Binding PauseCommand}" IsEnabled="{Binding CanPause}" Background="#F57F17" Foreground="White" FontWeight="Bold" BorderThickness="0" />
                <Button Content="▶️ Дальше" Width="90" Margin="5" Command="{Binding ResumeCommand}" IsEnabled="{Binding CanResume}" Background="#1565C0" Foreground="White" FontWeight="Bold" BorderThickness="0" />
                <Button Content="⏹ Стоп" Width="80" Margin="5" Command="{Binding StopCommand}" IsEnabled="{Binding CanStop}" Background="#C62828" Foreground="White" FontWeight="Bold" BorderThickness="0" />
            </StackPanel>
        </Border>

        <!-- Вкладки -->
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0" Margin="10">
            <TabControl.Resources>
                <!-- Тёмные вкладки с читаемым текстом -->
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabBorder" Background="#2D2D30" BorderBrush="#3E3E42" BorderThickness="1,1,1,0" CornerRadius="4,4,0,0" Padding="12,6" Margin="0,0,2,0">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="#3E3E42" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="#383838" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <!-- Белый текст строк в списках на тёмном фоне -->
                <Style TargetType="ListViewItem">
                    <Setter Property="Foreground" Value="White" />
                </Style>
            </TabControl.Resources>
            <TabItem Header="📊 Дашборд">
                <views:DashboardView DataContext="{Binding Dashboard}" />
            </TabItem>
            <TabItem Header="📈 Торговля">
                <views:TradingView DataContext="{Binding Trading}" />
            </TabItem>
            <TabItem Header="⚙️ Настройки">
                <views:SettingsView DataContext="{Binding Settings}" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>